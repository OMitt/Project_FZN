  dialogues:
  - speaker: 1
    text: "\u201CDid you hear how Steve died?\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 2
    text: "\"Don't say a word.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 1
    text: "\u201CThe creature could <color=red>change its shape</color>.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 1
    text: "\u201CIt hid among civilians before attacking.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 1
    text: "\u201CCreepy, huh?\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 2
    text: "\u201CI quit.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 1
    text: "\u201CCome on.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 1
    text: "\u201CWe\u2019ll finish the <color=red>autopsy report</color> in thirty
      minutes.\u201D"
