  dialogues:
  - speaker: 0
    text: Inside, half-digested flesh remains.
    triggerEvents: []
    sounds: []
  - speaker: 0
    text: "As you sift through the mess, you find something\u2014decayed, yellowed
      teeth."
    triggerEvents: []
    sounds: []
  - speaker: 0
    text: "They\u2019re the same ones you examined just minutes ago. You\u2019re
      sure of it."
    triggerEvents: []
    sounds: []
  - speaker: 2
    text: "\u201CWow\u2026Impressive.\u201D"
    triggerEvents: []
    sounds: []
  - speaker: 2
    text: "The assistant\u2019s admiration sounds completely genuine."
    triggerEvents: []
    sounds: []
